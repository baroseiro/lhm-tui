{
  "$schema": "./schema/lhm-tui.schema.json",
  "server": {
    "url": "http://127.0.0.1:8085",
    "username": null,
    "password": null,
    "password_env": null,
    "password_file": null,
    "poll_interval_ms": 1000,
    "request_timeout_ms": 2000,
    "gzip": true,
    "verify_version": true,
    "retry": {
      "initial_ms": 500,
      "max_ms": 30000,
      "factor": 2.0,
      "jitter": 0.1
    }
  },
  "history": {
    "window_s": 900,
    "max_points_per_series": 3600
  },
  "ui": {
    "fps": 30,
    "layout": [
      "cpu",
      "gpu",
      "memory"
    ],
    "show_header": true,
    "show_footer": true,
    "max_height": 12,
    "table_sort": "value_desc",
    "ascii": false,
    "no_color": false,
    "pause_position": false,
    "auto_height": true
  },
  "charts": {
    "enabled": false,
    "marker": "braille",
    "height": 8,
    "window": "5m",
    "window_cycle": [
      "1m",
      "5m",
      "15m"
    ],
    "y_mode": "auto",
    "y_min": null,
    "y_max": null,
    "min_span": 1.0,
    "grid": true,
    "legend": true,
    "blend_overlap": false
  },
  "theme": {
    "name": "default",
    "accent": "cyan",
    "text": "#c0caf5",
    "muted": "gray",
    "warn": "#e0af68",
    "crit": "#f7768e",
    "cpu": "#7aa2f7",
    "gpu": "#bb9af7",
    "memory": "#9ece6a",
    "network": "#7dcfff",
    "storage": "#e0af68",
    "thresholds": {
      "temperature": {
        "warn": 80.0,
        "crit": 95.0
      },
      "load": {
        "warn": 90.0,
        "crit": 98.0
      },
      "gpu_memory": {
        "warn": 90.0,
        "crit": 97.0
      }
    }
  },
  "panels": {
    "cpu": {
      "enabled": true,
      "show": [
        "temp",
        "load",
        "core_loads",
        "clock",
        "power"
      ]
    },
    "gpu": {
      "enabled": true,
      "include": [
        "GpuNvidia",
        "GpuAmd",
        "GpuIntel"
      ],
      "per_row": 2,
      "show": [
        "load",
        "memory",
        "temp",
        "power",
        "fan",
        "clock"
      ]
    },
    "memory": {
      "enabled": true,
      "show": [
        "used",
        "load",
        "virtual"
      ]
    },
    "thermal": {
      "enabled": true
    },
    "fans": {
      "enabled": false
    },
    "power": {
      "enabled": false
    },
    "storage": {
      "enabled": false
    },
    "network": {
      "enabled": false
    },
    "sensor_overrides": {},
    "custom": []
  },
  "fan_guard": {
    "enabled": true,
    "floor_percent": 45.0,
    "idle_load_percent": 10.0,
    "idle_temp_c": 65.0,
    "release_load_margin_percent": 10.0,
    "release_temp_margin_c": 5.0
  },
  "keys": {
    "ascii": [
      "a"
    ],
    "browser": [
      "b"
    ],
    "debug": [
      "d"
    ],
    "focus_next": [
      "tab"
    ],
    "focus_prev": [
      "shift+tab",
      "backtab"
    ],
    "help": [
      "?",
      "h"
    ],
    "pause": [
      "p",
      "space"
    ],
    "quit": [
      "q",
      "esc",
      "ctrl+c"
    ],
    "reload": [
      "r"
    ],
    "reset_minmax": [
      "m"
    ],
    "sort": [
      "s"
    ],
    "toggle_charts": [
      "c"
    ],
    "toggle_fan_guard": [
      "f"
    ],
    "toggle_thermal": [
      "t"
    ],
    "window_next": [
      "g"
    ],
    "window_prev": [
      "G"
    ],
    "zoom": [
      "enter"
    ]
  }
}
